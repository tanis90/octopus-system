<section class="tab" data-application-part="background">
  <div class="identity-grid">{{#each paperIdentity as |field|}}<div class="identity-field"><span>{{field.label}}</span><b>{{field.value}}</b></div>{{/each}}</div>
  <div class="section-heading"><strong>背景要素</strong><span class="key-summary">关键链接：{{cocPaper.keySummary}}</span></div>
  <div class="bio-grid">
    {{#each background.fields as |field|}}
    <section class="bio-card {{field.wide}}" data-bio="{{field.key}}"><header class="bio-head"><h3>{{field.label}}</h3>{{#if ../canEditSheet}}<button type="button" class="key-toggle" data-action="cocBackgroundKeyLink" data-key="{{field.key}}" aria-pressed="{{field.keyLink}}">关键链接</button>{{/if}}</header>{{#if ../isCoCEdit}}<textarea class="prose" data-coc-background-key="{{field.key}}">{{field.value}}</textarea>{{else}}<div class="prose">{{field.value}}</div>{{/if}}</section>
    {{/each}}
  </div>
  {{#if background.story.value}}<section class="story"><h3>{{background.story.label}}</h3>{{#if isCoCEdit}}<textarea class="prose" data-coc-background-key="{{background.story.key}}">{{background.story.value}}</textarea>{{else}}<div class="prose">{{background.story.value}}</div>{{/if}}</section>{{/if}}
  {{#if background.encounters.value}}<section class="story"><h3>{{background.encounters.label}}</h3>{{#if isCoCEdit}}<textarea class="prose" data-coc-background-key="{{background.encounters.key}}">{{background.encounters.value}}</textarea>{{else}}<div class="prose">{{background.encounters.value}}</div>{{/if}}</section>{{/if}}
</section>
