<section class="actor tab coc-background {{tab.cssClass}}" data-group="primary" data-tab="background">
  <section class="coc-background-identity">
    <div><b>{{background.profession.name}}</b>{{#if background.creditRating}}<span>信用评级 {{background.creditRating.value}}%{{#if background.creditRating.min}}（职业范围 {{background.creditRating.min}}–{{background.creditRating.max}}）{{/if}}</span>{{/if}}</div>
    <div class="coc-background-fields">
      {{#each background.identity as |field|}}<label>{{field.label}}{{#if ../isCoCEdit}}<input name="system.infos.{{field.key}}" value="{{field.value}}">{{else}}<span>{{field.value}}</span>{{/if}}</label>{{/each}}
    </div>
  </section>
  <div class="coc-background-grid">
    {{#each background.fields as |field|}}
    <section class="coc-background-field"><h2>{{field.label}}</h2>{{#if ../isCoCEdit}}<textarea data-coc-background-key="{{field.key}}">{{field.value}}</textarea>{{else}}<div>{{field.value}}</div>{{/if}}</section>
    {{/each}}
  </div>
  {{#if background.legacy}}<section class="coc-background-legacy"><h2>背景故事</h2>{{#if isCoCEdit}}<textarea name="system.backstory">{{background.legacy}}</textarea>{{else}}<div>{{background.legacy}}</div>{{/if}}</section>{{/if}}
</section>
