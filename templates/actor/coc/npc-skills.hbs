<section class="tab" data-application-part="skills">
  <div class="toolbar" data-coc-local><label class="search"><input type="search" placeholder="搜索技能…" data-coc-skill-search aria-label="搜索技能"></label><label class="select-shell"><select data-coc-skill-sort aria-label="技能排序"><option value="value">按数值</option><option value="name">按名称</option><option value="custom">自定义</option></select></label><span class="toolbar-spacer"></span><span>{{cocNpc.skills.total}} 项技能</span></div>
  <table><thead><tr><th>技能</th><th>当前</th><th>半值</th><th>1/5</th><th><span class="edit-only">操作</span></th></tr></thead><tbody data-coc-skill-list>
    {{#each cocNpc.skillRows as |skill|}}<tr class="item" data-item-id="{{skill.id}}" data-coc-skill-row data-name="{{skill.name}}" data-total="{{skill.total}}"><td><button type="button" class="skill-name" data-action="cocNpcSkillRoll">{{skill.name}}</button></td><td class="current">{{#if ../isCoCEdit}}<input class="inline-edit" data-field="base" type="number" value="{{skill.base}}" data-dtype="Number" aria-label="{{skill.name}} 基础值">{{else}}{{skill.total}}%{{/if}}</td><td>{{skill.half}}</td><td>{{skill.fifth}}</td><td class="row-actions"><button type="button" data-action="paperOpenItem">打开</button>{{#if ../isCoCEdit}}<button type="button" data-action="cocNpcDeleteItem">删除</button>{{/if}}</td></tr>{{else}}<tr><td colspan="5">暂无技能</td></tr>{{/each}}
  </tbody></table>
</section>
