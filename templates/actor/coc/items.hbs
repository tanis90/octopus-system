<section class="tab" data-application-part="items">
  <div class="money"><div><span>信用评级</span><strong>{{paperMoney.credit}}</strong></div><div><span>现金</span><strong>{{paperMoney.symbol}} {{paperMoney.cash}}</strong></div><div><span>资产</span><strong>{{paperMoney.symbol}} {{paperMoney.assets}}</strong></div><div><span>消费水平</span><strong>{{paperMoney.symbol}} {{paperMoney.spendingLevel}}</strong></div></div>
  <details class="item-section" open><summary>武器 <span>{{weapons.length}} 项</span></summary>{{#each weapons as |weapon|}}<div class="item-row item" data-item-id="{{weapon.id}}"><i class="item-symbol">武</i><button type="button" class="item-name" data-action="paperOpenItem">{{weapon.name}}</button><span class="item-meta">{{weapon.equipStatusLabel}} · {{weapon.ammo}}</span></div>{{/each}}</details>
  <details class="item-section" open><summary>护甲 <span>{{armours.length}} 项</span></summary>{{#each armours as |armour|}}<div class="item-row item" data-item-id="{{armour.id}}"><i class="item-symbol">护</i><button type="button" class="item-name" data-action="paperOpenItem">{{armour.name}}</button><span class="item-meta">护甲 {{armour.av1}}</span></div>{{/each}}</details>
  <details class="item-section"><summary>书籍 <span>{{paperBooks.length}} 项</span></summary>{{#each paperBooks as |book|}}<div class="item-row"><i class="item-symbol">书</i><span class="item-name">{{book.name}}</span><span class="item-meta">阅读 {{book.progress}} / {{book.total}}</span></div>{{/each}}</details>
  <details class="item-section"><summary>法术 <span>0 项</span></summary></details>
  <details class="item-section"><summary>天赋 <span>{{cocPaper.talentCount}} 项</span></summary>{{#each gears as |gear|}}{{#if gear.isTalent}}<div class="item-row item" data-item-id="{{gear.id}}"><i class="item-symbol">赋</i><button type="button" class="item-name" data-action="paperOpenItem">{{gear.name}}</button></div>{{/if}}{{/each}}</details>
  <details class="item-section"><summary>道具 <span>{{cocPaper.gearCount}} 项</span></summary>{{#each gears as |gear|}}{{#unless gear.isTalent}}<div class="item-row item" data-item-id="{{gear.id}}"><i class="item-symbol">物</i><button type="button" class="item-name" data-action="paperOpenItem">{{gear.name}}</button><span class="item-meta">×{{gear.quantity}} · {{gear.equipStatusLabel}}</span></div>{{/unless}}{{/each}}</details>
  <details class="item-section"><summary>状态 <span>0 项</span></summary></details>
</section>
