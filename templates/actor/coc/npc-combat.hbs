<section class="tab" data-application-part="combat">
  <div class="toolbar"><strong>武器与攻击</strong><span class="toolbar-spacer"></span>{{#if isCoCEdit}}<button type="button" class="small-button" data-action="createDoc" data-document-class="Item" data-type="weapon">＋ 添加武器</button>{{/if}}</div>
  <div class="table-scroll"><table class="weapon-table"><thead><tr><th>武器</th><th>使用技能</th><th>备选技能</th><th>伤害</th><th>射程</th><th>子弹 / 弹容量</th><th>故障</th><th>操作</th></tr></thead><tbody>{{#each cocNpc.attacks as |weapon|}}<tr class="item" data-item-id="{{weapon.id}}"><td><button type="button" class="item-name" data-action="paperOpenItem">{{weapon.name}}</button></td><td>{{#if weapon.skillName}}{{weapon.skillName}} {{weapon.hitLabel}}{{else}}—{{/if}}</td><td>—</td><td>{{weapon.damage}}</td><td>{{weapon.range}}</td><td><button type="button" data-action="paperReloadWeapon">{{weapon.ammo}}</button></td><td>{{weapon.mal}}</td><td class="row-actions">{{#if weapon.attackable}}<button type="button" data-action="cocNpcAttack">攻击</button>{{/if}}{{#if weapon.damageRollable}}<button type="button" data-action="cocNpcDamage">伤害</button>{{/if}}<button type="button" data-action="paperOpenItem">打开</button>{{#if ../isCoCEdit}}<button type="button" data-action="cocNpcDeleteItem">删除</button>{{/if}}</td></tr>{{else}}<tr><td colspan="8">暂无武器</td></tr>{{/each}}</tbody></table></div>
  {{#if cocNpc.powers.length}}<div class="section-heading"><strong>特殊能力</strong><small>{{cocNpc.powers.length}} 项</small></div><div class="talent-list">{{#each cocNpc.powers as |power|}}<button type="button" class="talent item" data-action="paperOpenItem" data-item-id="{{power.id}}"><strong>{{power.name}}</strong><span>{{{power.descriptionHtml}}}</span></button>{{/each}}</div>{{/if}}
  <div class="section-heading"><strong>移动方式</strong></div>
  <div class="movement-list"><div class="movement-row"><span>主移动力</span><span class="movement-value">{{cocNpc.header.derived.mov}}</span><span class="movement-type">{{cocNpc.special.movType}}</span><small>{{#if cocNpc.special.movAuto}}由系统派生{{/if}}</small></div>{{#each cocNpc.special.movement as |movement|}}<div class="movement-row"><span>额外移动</span><span class="movement-value">{{movement.value}}</span><span class="movement-type">{{movement.type}}</span><small></small></div>{{/each}}</div>
</section>
