<section class="tab" data-application-part="growth">
  <div class="points"><div class="point"><span>兴趣</span><strong>{{cocPaper.development.personal}}</strong></div><div class="point"><span>职业</span><strong>{{cocPaper.development.occupation}}</strong></div><div class="point"><span>原型</span><strong>{{cocPaper.development.archetype}}</strong></div><div class="point"><span>经验包</span><strong>{{cocPaper.development.experiencePackage}}</strong></div></div>
  <div class="section-heading"><strong>可以成长的技能</strong><div class="heading-actions">{{#if isCoCEdit}}<button type="button" class="small-button primary" data-action="cocInterlude">一键成长</button>{{/if}}</div></div>
  <table><thead><tr><th>技能</th><th>基础</th><th>当前</th><th>半值</th><th>1/5</th><th>成长</th><th>操作</th></tr></thead><tbody>{{#each cocPaper.growthSkills as |skill|}}<tr class="item" data-item-id="{{skill.id}}"><td>{{skill.name}}</td><td>{{skill.base}}</td><td class="current">{{skill.total}}</td><td>{{skill.half}}</td><td>{{skill.fifth}}</td><td><button type="button" class="mark" data-action="cocToggleGrowth" aria-pressed="{{skill.improve}}">{{#if skill.improve}}×{{/if}}</button></td><td class="row-actions"><button type="button" data-action="paperOpenItem">调整</button></td></tr>{{else}}<tr><td colspan="7">没有已标记成长的技能</td></tr>{{/each}}</tbody></table>
  <div class="section-heading"><strong>成长记录</strong><div class="heading-actions"><small>当前模组：{{cocPaper.growthModule}}</small>{{#if isCoCEdit}}<input name="cocGrowthModuleName" placeholder="模组名称" aria-label="新模组名称"><button type="button" class="small-button" data-action="cocGrowthModule">＋ 新建模组</button>{{/if}}</div></div>
  <div class="record">{{#each cocPaper.growthLog as |entry|}}<div class="record-row"><time>{{entry.timeLabel}}</time><span>{{entry.skillName}}</span><span class="num">{{entry.before}} → {{entry.after}}</span><span class="delta">{{entry.deltaLabel}}</span>{{#if ../isCoCEdit}}<button type="button" data-action="cocUndoGrowth" data-entry-id="{{entry.id}}" aria-label="撤销成长">↺</button>{{/if}}</div>{{else}}<div class="note-line">暂无成长记录</div>{{/each}}</div>
</section>
