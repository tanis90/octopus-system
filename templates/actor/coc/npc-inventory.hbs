<section class="tab" data-application-part="inventory">
  <details class="item-section" open><summary>护甲 <span>{{cocNpc.equipment.armours.length}} 项</span></summary>{{#each cocNpc.equipment.armours as |item|}}<div class="item-row item" data-item-id="{{item.id}}"><i class="item-symbol">护</i><button type="button" class="item-name" data-action="paperOpenItem">{{item.name}}</button><span class="item-meta">×{{item.quantity}}</span></div>{{/each}}</details>
  <details class="item-section"><summary>书籍 <span>{{paperBooks.length}} 项</span></summary>{{#each paperBooks as |book|}}<div class="item-row"><i class="item-symbol">书</i><span class="item-name">{{book.name}}</span><span class="item-meta">{{book.progress}} / {{book.total}}</span></div>{{/each}}</details>
  <details class="item-section"><summary>法术 <span>{{cocPaper.spellCount}} 项</span></summary>{{#each cocNpc.powers as |power|}}{{#if power.isSpell}}<div class="item-row item" data-item-id="{{power.id}}"><i class="item-symbol">术</i><button type="button" class="item-name" data-action="paperOpenItem">{{power.name}}</button></div>{{/if}}{{/each}}</details>
  <details class="item-section"><summary>天赋 <span>{{cocPaper.talentCount}} 项</span></summary>{{#each cocNpc.powers as |power|}}{{#unless power.isSpell}}<div class="item-row item" data-item-id="{{power.id}}"><i class="item-symbol">赋</i><button type="button" class="item-name" data-action="paperOpenItem">{{power.name}}</button><span class="item-meta">{{power.typeLabel}}</span></div>{{/unless}}{{/each}}</details>
  <details class="item-section"><summary>道具 <span>{{cocNpc.equipment.gears.length}} 项</span></summary>{{#each cocNpc.equipment.gears as |item|}}<div class="item-row item" data-item-id="{{item.id}}"><i class="item-symbol">物</i><button type="button" class="item-name" data-action="paperOpenItem">{{item.name}}</button><span class="item-meta">×{{item.quantity}}</span></div>{{/each}}</details>
  <details class="item-section"><summary>状态 <span>0 项</span></summary></details>
</section>
