{{! Description Tab (CoC7 native system.description.value) }}
<section class='item tab description {{tab.cssClass}}' data-group='primary' data-tab='description'>
  <div class="bold">{{localize 'BRP.description'}}</div>
  <div class="description-doc">
    {{#if editable}}
      <prose-mirror name="system.description.value" data-document-u-u-i-d="{{item.uuid}}" value="{{system.description.value}}"
        collaborate="true" toggled="true">
        {{{enrichedDescription}}}
      </prose-mirror>
    {{else}}
      {{{enrichedDescription}}}
    {{/if}}
  </div>
</section>
