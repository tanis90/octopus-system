<section class='item tab details {{tab.cssClass}}' data-group='primary' data-tab='details'>
  <div class="base-grid">
    <div class="item-title">命中技能（主）</div>
    <div class="stat-input"><input name="system.skill.main.name" type="text" value="{{system.skill.main.name}}" /></div>
    <div class="item-title">技能 ID</div>
    <div class="stat-input"><input name="system.skill.main.id" type="text" value="{{system.skill.main.id}}" /></div>
    <div class="item-title">命中技能（备选）</div>
    <div class="stat-input"><input name="system.skill.alternativ.name" type="text" value="{{system.skill.alternativ.name}}" /></div>
    <div class="item-title">技能 ID</div>
    <div class="stat-input"><input name="system.skill.alternativ.id" type="text" value="{{system.skill.alternativ.id}}" /></div>
  </div>
  <div class="item-title">射程与伤害</div>
  <div class="base-grid">
    {{#each rangeRows as |row|}}
      <div class="item-title">{{row.label}}射程</div>
      <div class="stat-input"><input name="system.range.{{row.key}}.value" type="text" value="{{row.value}}" /></div>
      <div class="item-title">{{row.label}}伤害</div>
      <div class="stat-input"><input name="system.range.{{row.key}}.damage" type="text" value="{{row.damage}}" /></div>
    {{/each}}
  </div>
  <div class="base-grid">
    <div class="item-title">每轮次数</div>
    <div class="stat-input"><input name="system.usesPerRound.normal" type="text" value="{{system.usesPerRound.normal}}" /></div>
    <div class="item-title">最大次数</div>
    <div class="stat-input"><input name="system.usesPerRound.max" type="number" value="{{system.usesPerRound.max}}" /></div>
    <div class="item-title">连发数</div>
    <div class="stat-input"><input name="system.usesPerRound.burst" type="number" value="{{system.usesPerRound.burst}}" /></div>
    <div class="item-title">弹匣</div>
    <div class="stat-input"><input name="system.bullets" type="number" value="{{system.bullets}}" /></div>
    <div class="item-title">弹药量</div>
    <div class="stat-input"><input name="system.ammo" type="number" value="{{system.ammo}}" /></div>
    <div class="item-title">故障值</div>
    <div class="stat-input"><input name="system.malfunction" type="number" value="{{system.malfunction}}" /></div>
    <div class="item-title">爆炸半径</div>
    <div class="stat-input"><input name="system.blastRadius" type="text" value="{{system.blastRadius}}" /></div>
  </div>
  <div class="item-title">属性</div>
  <div class="options-grid">
    {{#each propertyRows as |row|}}
      <label><input type="checkbox" name="system.properties.{{row.key}}" {{checked row.checked}} /> {{row.label}}</label>
    {{/each}}
  </div>
</section>
