<section class='item tab details {{tab.cssClass}}' data-group='primary' data-tab='details'>
  <div class="base-grid">
    <div class="item-title">技能名</div>
    <div class="stat-input"><input name="system.skillName" type="text" value="{{system.skillName}}" /></div>
    <div class="item-title">专精</div>
    <div class="stat-input"><input name="system.specialization" type="text" value="{{system.specialization}}" /></div>
    <div class="item-title">基础值</div>
    <div class="stat-input"><input name="system.base" type="text" value="{{system.base}}" /></div>
    <div class="item-title">合计</div>
    <div class="stat-display boxed centre">{{skillTotal}}</div>
  </div>
  <div class="item-title">调整值</div>
  <div class="base-grid">
    {{#each adjustmentRows as |row|}}
      <div class="item-title">{{row.label}}</div>
      <div class="stat-input"><input name="system.adjustments.{{row.key}}" type="number" value="{{row.value}}" /></div>
    {{/each}}
  </div>
  <div class="item-title">属性</div>
  <div class="options-grid">
    {{#each propertyRows as |row|}}
      <label><input type="checkbox" name="system.properties.{{row.key}}" {{checked row.checked}} /> {{row.label}}</label>
    {{/each}}
  </div>
</section>
